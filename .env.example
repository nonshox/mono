# Appwrite (all required)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=

# Telegram bot (optional — the base ships a working Telegram link flow)
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cron (optional — the evening nudge (/api/cron/nudge) is skipped without it)
CRON_SECRET=

# Gemini (optional — powers the opt-in Mono AI: weekly letter, smarter nudge, year review)
GEMINI_API_KEY=
GEMINI_MODEL=


# Appwrite (all required)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=

# Telegram bot (optional — the base ships a working Telegram link flow)
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cron (optional — the evening nudge (/api/cron/nudge) is skipped without it)
CRON_SECRET=

# Public origin for metadata / canonical URLs (/about, /sitemap.xml, structured data).
# Set to your deployed URL (e.g. https://promono.vercel.app). Falls back to $VERCEL_URL on Vercel.
NEXT_PUBLIC_SITE_URL=

# Gemini (optional — powers the opt-in Mono AI: weekly letter, smarter nudge, year review)
GEMINI_API_KEY=
GEMINI_MODEL=

# Not read by the app — retained for reference. The nudge workflow hardcodes the
# target URL inline in .github/workflows/cron.yml; only CRON_SECRET must be set as a repo secret.
MONO_URL=